# ============================================================================
# Backend Environment Variables (.env)
# Copy this file to .env and fill in your actual values
# ============================================================================

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_APP=backend/web_server:app

# Security
JWT_SECRET_KEY=your-very-secure-random-key-minimum-32-characters-long-change-this
JWT_EXPIRATION_HOURS=24

# Database
DATABASE_URL=sqlite:////app/database/sensors.db
DATABASE_ECHO=False

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=mqtt_password
MQTT_SUBSCRIBE_TOPICS=sensors/#,alerts/#
MQTT_CLIENT_ID=landslide-monitoring-server

# API Server
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com,https://www.yourdomain.com

# Timezone
TIMEZONE=Asia/Ho_Chi_Minh

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Email Notifications (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=True

# Alert Configuration
ALERT_EMAIL_RECIPIENTS=admin@example.com,user@example.com
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Data Retention
DATA_RETENTION_DAYS=90

# Performance
CACHE_ENABLED=True
CACHE_TYPE=simple
CACHE_TIMEOUT=300
